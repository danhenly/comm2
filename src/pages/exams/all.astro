---
import Base from '../../layouts/Base.astro';
import allItems from '../../data/exams/all.json';

const items = allItems as any[];
const _graderRaw = (import.meta.env.PUBLIC_GRADER_URL ?? 'http://localhost:8000/grade').replace(/\/+$/, '');
const graderUrl = _graderRaw.endsWith('/grade') ? _graderRaw : _graderRaw + '/grade';
const storageKey = 'comm2-exam-all';
---
<style>.spinner{display:inline-block;width:14px;height:14px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.8s linear infinite;vertical-align:-2px}@keyframes spin{to{transform:rotate(360deg)}}</style>
<Base title="Exam all — Comm2 Reviewer">
  <p><a href="/">&larr; Home</a></p>
  <h1>Exam: whole course</h1>
  <p class="meta">{items.length} items · grader: {graderUrl} (falls back to model answer if unreachable)</p>

  <script type="application/json" id="exam-data" set:html={JSON.stringify(items)} />
  <div id="exam-app" data-part="all" data-grader={graderUrl} data-storage={storageKey}>
    <p class="meta" id="exam-counter"></p>
    <div class="card">
      <p><span id="exam-badge"></span><span class="meta" id="exam-section"></span></p>
      <p id="exam-stem" style="font-weight: bold;"></p>
      <p class="meta" id="exam-auth"></p>
      <label for="exam-attempt"><strong>Your attempt</strong></label>
      <textarea id="exam-attempt" rows="6" style="width: 100%; font-family: Georgia, serif; font-size: 11pt;"></textarea>
      <p style="margin-top: 0.6rem;">
        <button class="btn primary" id="exam-submit" type="button">Submit</button>
        {' '}
        <button class="btn" id="exam-reveal" type="button">Reveal model answer</button>
        {' '}
        <button class="btn" id="exam-prev" type="button">&larr; Prev</button>
        {' '}
        <button class="btn" id="exam-next" type="button">Next &rarr;</button>
      </p>
    </div>
    <div id="exam-loading" hidden class="card" role="status" aria-live="polite" style="border-left: 4px solid var(--accent);">
      <p><strong>Grading your answer…</strong></p>
      <p class="meta">The machine is checking your answer against the ALAC rubric — answer, legal basis, application, conclusion — and pulling the evidence quotes. Analysis will appear in a few seconds. Please wait.</p>
      <p class="meta"><span class="spinner" aria-hidden="true"></span> working…</p>
    </div>
    <div id="exam-result"></div>
  </div>

  <script>
    (() => {
      const app = document.getElementById('exam-app');
      if (!app) return;
      const dataEl = document.getElementById('exam-data');
      const items = JSON.parse(dataEl?.textContent || '[]');
      const normGrader = (u) => { const s = (u || '').replace(/\/+$/, ''); return s.endsWith('/grade') ? s : s + '/grade'; };
      const graderUrl = normGrader(app.dataset.grader || 'http://localhost:8000/grade');
      const storageKey = app.dataset.storage || 'comm2-exam-all';
      const badge = document.getElementById('exam-badge');
      const section = document.getElementById('exam-section');
      const stem = document.getElementById('exam-stem');
      const auth = document.getElementById('exam-auth');
      const counter = document.getElementById('exam-counter');
      const attempt = document.getElementById('exam-attempt');
      const submitBtn = document.getElementById('exam-submit');
      const revealBtn = document.getElementById('exam-reveal');
      const prevBtn = document.getElementById('exam-prev');
      const nextBtn = document.getElementById('exam-next');
      const result = document.getElementById('exam-result');
      let idx = 0;
      let store = {};
      try { store = JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch { store = {}; }
      const save = () => { try { localStorage.setItem(storageKey, JSON.stringify(store)); } catch {} };

      function showModel(item, grade) {
        if (!result) return;
        result.innerHTML = '';
        if (grade && grade.components && Array.isArray(grade.components)) {
          grade.components.slice(0, 4).forEach((c) => {
            const div = document.createElement('div');
            div.className = 'alac';
            const title = document.createElement('strong');
            title.textContent = `${c.id || c.name || c.label || c.title || 'ALAC'} — ${c.band || c.score || ''}`;
            div.appendChild(title);
            if (c.verdict) {
              const v = document.createElement('p');
              v.textContent = String(c.verdict);
              div.appendChild(v);
            }
            const evRaw = c.evidence || c.quotes;
            if (evRaw) {
              const arr = Array.isArray(evRaw) ? evRaw : [evRaw];
              const quotes = arr.map((e) => (typeof e === 'string' ? e : (e && (e.quote ?? e.text ?? e.excerpt)) || '')).filter(Boolean);
              if (quotes.length) {
                const p = document.createElement('p');
                p.textContent = `Evidence: ${quotes.join(' / ')}`;
                div.appendChild(p);
              }
            }
            if (c.fix || c.feedback) {
              const p2 = document.createElement('p');
              p2.textContent = `Fix: ${c.fix || c.feedback}`;
              div.appendChild(p2);
            }
            result.appendChild(div);
          });
          if (grade.total !== undefined || grade.score !== undefined) {
            const t = document.createElement('p');
            t.innerHTML = `<strong>Total: ${grade.total ?? grade.score} / 5</strong>`;
            result.appendChild(t);
          }
        }
        const tips = (grade && grade.suggestions) || [];
        if (tips.length) {
          const h2 = document.createElement('h3');
          h2.textContent = 'How to improve';
          result.appendChild(h2);
          const ol = document.createElement('ol');
          tips.forEach((t) => {
            const li = document.createElement('li');
            li.textContent = typeof t === 'string' ? t : (t && (t.text ?? t.suggestion ?? t.fix)) || JSON.stringify(t);
            ol.appendChild(li);
          });
          result.appendChild(ol);
        }
        const h = document.createElement('h3');
        h.textContent = 'Model answer (A:)';
        result.appendChild(h);
        const pre = document.createElement('pre');
        pre.style.whiteSpace = 'pre-wrap';
        pre.textContent = item.answer || '(missing A: block)';
        result.appendChild(pre);
      }

      function render() {
        if (!items.length) {
          if (counter) counter.textContent = 'No items.';
          return;
        }
        const item = items[idx];
        if (counter) counter.textContent = `Item ${idx + 1} / ${items.length} — ${item.id} (${item.part})`;
        if (badge) {
          badge.textContent = '';
          badge.className = '';
          if (item.kind === 'historic') {
            badge.textContent = `${item.year || ''} Bar`.trim();
            badge.className = 'badge historic';
          } else {
            badge.textContent = 'Q';
            badge.className = 'badge';
          }
        }
        if (section) section.textContent = item.section || '';
        if (stem) stem.textContent = item.stem || '';
        if (auth) auth.textContent = item.authorities || '';
        // localStorage keeps the attempt text only (nothing graded is stored server-side).
        const savedAttempt = typeof store[item.id] === 'string' ? store[item.id] : '';
        if (attempt) attempt.value = savedAttempt || '';
        if (result) result.innerHTML = '';
      }

      async function submit() {
        const item = items[idx];
        if (!item || !attempt) return;
        const attemptText = attempt.value;
        store[item.id] = attemptText;
        save();
        const loading = document.getElementById('exam-loading');
        if (loading) loading.hidden = false;
        if (submitBtn) submitBtn.disabled = true;
        try {
          const res = await fetch(graderUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id: item.id,
              stem: item.stem,
              answer: attemptText,
              profile: item.profile,
              authorities: item.authorities,
            }),
          });
          if (!res.ok) throw new Error(`grader ${res.status}`);
          const grade = await res.json();
          save();
          showModel(item, grade);
        } catch {
          // Grader unreachable: fall back to revealing the model A: block.
          save();
          showModel(item, null);
        } finally {
          if (loading) loading.hidden = true;
          if (submitBtn) submitBtn.disabled = false;
        }
      }

      submitBtn?.addEventListener('click', submit);
      revealBtn?.addEventListener('click', () => {
        const item = items[idx];
        if (!item) return;
        store[item.id] = attempt?.value || '';
        save();
        showModel(item, null);
      });
      prevBtn?.addEventListener('click', () => { if (idx > 0) { idx--; render(); } });
      nextBtn?.addEventListener('click', () => { if (idx < items.length - 1) { idx++; render(); } });
      attempt?.addEventListener('input', () => {
        const item = items[idx];
        if (!item) return;
        store[item.id] = attempt.value;
        save();
      });
      render();
    })();
  </script>
</Base>
