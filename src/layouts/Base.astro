---
interface Props {
  title?: string;
}
const { title = 'Comm2 Reviewer' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      :root {
        --tint: #f4f6fb;
        --border: #c9d1e0;
        --accent: #1f3a8a;
        --quote-bg: #f7f3e8;
        --quote-border: #c8a84b;
        --code-bg: #f6f4ec;
        --zebra: #fafbfd;
      }
      * { box-sizing: border-box; }
      body {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 12pt;
        line-height: 1.5;
        margin: 0;
        color: #1a1a1a;
        background: #fff;
      }
      nav.top {
        position: sticky;
        top: 0;
        z-index: 50;
        background: #fff;
        border-bottom: 1px solid var(--border);
      }
      nav.top .inner {
        max-width: 7.5in;
        margin: 0 auto;
        padding: 0.6rem 1rem;
        display: flex;
        gap: 1rem;
        align-items: center;
      }
      nav.top a { color: var(--accent); text-decoration: none; font-size: 11pt; }
      nav.top a:hover { text-decoration: underline; }
      nav.top .brand { font-weight: bold; margin-right: auto; }
      main {
        max-width: 7.5in;
        margin: 0 auto;
        padding: 1.5rem 1rem 4rem;
      }
      blockquote {
        border: 1px solid var(--quote-border);
        border-left: 4px solid var(--quote-border);
        background: var(--quote-bg);
        margin: 1.1rem 0;
        padding: 0.85rem 1.1rem;
        border-radius: 0 6px 6px 0;
        font-style: italic;
      }
      blockquote p { margin: 0.3em 0; }
      blockquote p:first-child { margin-top: 0; }
      blockquote p:last-child { margin-bottom: 0; }
      blockquote blockquote {
        margin: 0.5rem 0 0.2rem 0.6rem;
        border-left-width: 3px;
      }
      blockquote strong, blockquote em { font-style: normal; }
      blockquote cite, blockquote footer {
        display: block;
        font-style: normal;
        font-size: 9pt;
        color: #666;
        margin-top: 0.4rem;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9.5pt;
        line-height: 1.45;
        margin: 1.1rem 0;
        background: #fff;
      }
      caption {
        font-size: 10pt;
        font-weight: bold;
        text-align: left;
        padding: 0 0 0.4rem 0;
        color: #333;
      }
      th, td {
        border: 1px solid var(--border);
        padding: 0.55rem 0.7rem;
        text-align: left;
        vertical-align: top;
      }
      thead th, th {
        background: #e8edf7;
        font-weight: bold;
        letter-spacing: 0.01em;
      }
      tbody tr:nth-child(even) td { background: var(--zebra); }
      td:first-child { font-weight: 600; }
      article table { display: table; }
      .card table { margin: 0.6rem 0; }
      pre {
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.85rem 1.1rem;
        overflow-x: auto;
        font-size: 9.5pt;
        line-height: 1.5;
      }
      code {
        font-size: 0.88em;
        background: var(--code-bg);
        border: 1px solid #e3ddc8;
        border-radius: 4px;
        padding: 0.05em 0.35em;
      }
      pre code { background: none; border: 0; padding: 0; }
      .card {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
        background: #fff;
      }
      .grid { display: grid; gap: 1rem; }
      @media (min-width: 700px) {
        .grid.two { grid-template-columns: 1fr 1fr; }
      }
      .btn {
        display: inline-block;
        border: 1px solid var(--accent);
        color: var(--accent);
        border-radius: 6px;
        padding: 0.35rem 0.75rem;
        text-decoration: none;
        font-size: 10pt;
        background: #fff;
        cursor: pointer;
      }
      .btn.primary { background: var(--accent); color: #fff; }
      .badge {
        display: inline-block;
        font-size: 9pt;
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.1rem 0.6rem;
        color: var(--accent);
        margin-right: 0.4rem;
      }
      .badge.historic { background: var(--accent); color: #fff; }
      .meta { font-size: 9pt; color: #555; }
      .alac { border-left: 4px solid var(--accent); background: var(--tint); padding: 0.6rem 0.8rem; margin: 0.6rem 0; }
    </style>
  </head>
  <body>
    <nav class="top">
      <div class="inner">
        <a class="brand" href="/">Comm2 Reviewer</a>
        <a href="/">Home</a>
        <a href="/#parts">Parts</a>
        <a href="/exams/all">Exams</a>
        <a href="/#pdfs">PDFs</a>
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
