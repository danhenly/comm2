# Copy to grader/.env (never commit the real file — .gitignore covers .env).
# The grader is stateless: these only configure the upstream model call.

# OpenAI-compatible chat-completions endpoint.
# Default is the OpenCode Go gateway (uses your Go subscription, cost 0).
# Fallback inside app.py is https://api.deepseek.com (set GRADER_FALLBACK_BASE_URL to change it).
GRADER_BASE_URL=https://opencode.ai/inference/go/openai/v1/chat/completions

# API key for the endpoint above. NEVER commit a real key.
GRADER_API_KEY=

# Exact pinned model id, echoed back on every grade as `model` with `model_date`.
# Pin deliberately; re-grade a fixed baseline after any change (models rotate).
GRADER_MODEL=

# Law/jurisprudence cut-off passed to the examiner prompt (YYYY-MM-DD).
GRADER_CUTOFF=2025-06-30
