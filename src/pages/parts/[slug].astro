---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PART_ORDER, PART_LABEL, PART_PDF, pdfUrl } from '../../data/parts';

export async function getStaticPaths() {
  const parts = await getCollection('parts');
  return PART_ORDER.map((slug) => {
    const entry = parts.find((e: any) => {
      const id = (e.slug ?? e.id ?? '').replace(/\.mdx?$/, '');
      return id === slug;
    });
    if (!entry) throw new Error(`missing content entry for ${slug}`);
    return { params: { slug }, props: { entry } };
  });
}

const { slug } = Astro.params as { slug: string };
const { entry } = Astro.props as { entry: any };
const { Content, headings } = await render(entry);

const idx = PART_ORDER.indexOf(slug as any);
const prev = idx > 0 ? PART_ORDER[idx - 1] : null;
const next = idx >= 0 && idx < PART_ORDER.length - 1 ? PART_ORDER[idx + 1] : null;
const pdf = (PART_PDF as Record<string, string>)[slug];
const sections = (headings as { depth: number; slug: string; text: string }[]).filter(
  (h) => h.depth === 2 || h.depth === 3
);
const label = (PART_LABEL as Record<string, string>)[slug] ?? slug;
---
<Base title={`${label} — Comm2 Reviewer`}>
  <p><a href="/">&larr; Home</a></p>
  <h1>{label}</h1>
  <p class="meta">/{slug} · <a href={`/exams/${slug}`}>exam</a>{pdf ? (<span> · <a href={pdfUrl(pdf)}>PDF: {pdf}</a></span>) : null}</p>

  {sections.length > 0 && (
    <nav class="card" aria-label="Sections">
      <details open>
        <summary><strong>Sections</strong></summary>
      <ul>
        {sections.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ul>
      </details>
    </nav>
  )}

  <article id="reviewer-article">
    <Content />
  </article>

  <script>
    (() => {
      const article = document.getElementById('reviewer-article');
      if (!article || article.dataset.collapsed) return;
      article.dataset.collapsed = '1';
      const h2Targets = ['1. Coverage Map', '2. Learning Objectives', '3. Authority Inventory', '4. Three-Pass', '5. Syllabus Self-Check', '0. One-Page Outline'];
      const h3Targets = ['A. Cases', 'B. Laws'];
      const matches = (text, list) => list.some((s) => text.trim().startsWith(s));
      // Collect first, then wrap (live DOM mutation while iterating skips nodes).
      const h2s = Array.from(article.querySelectorAll('h2')).filter((h) => matches(h.textContent || '', h2Targets));
      const h3s = Array.from(article.querySelectorAll('h3')).filter((h) => matches(h.textContent || '', h3Targets));
      const wrap = (heading, stopSel, open) => {
        const details = document.createElement('details');
        details.className = 'card';
        if (open) details.open = true;
        if (heading.id) { details.id = heading.id; heading.removeAttribute('id'); }
        const summary = document.createElement('summary');
        summary.innerHTML = '<strong></strong>';
        summary.firstChild.textContent = heading.textContent || '';
        details.appendChild(summary);
        heading.parentNode.insertBefore(details, heading);
        details.appendChild(heading);
        heading.style.display = 'none';
        let n = details.nextSibling;
        while (n && !(n.nodeType === 1 && n.matches(stopSel))) {
          const cur = n;
          n = n.nextSibling;
          details.appendChild(cur);
        }
      };
      // Inner H3 first so they land inside their parent H2's details.
      h3s.forEach((h) => wrap(h, 'h2, h3', false));
      h2s.forEach((h) => wrap(h, 'h2', false));
    })();
  </script>

  <hr />
  <p>
    {prev && <a class="btn" href={`/parts/${prev}`}>&larr; {prev}</a>}
    {' '}
    {next && <a class="btn" href={`/parts/${next}`}>{next} &rarr;</a>}
  </p>
</Base>
