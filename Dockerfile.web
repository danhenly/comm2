# comm2-web: static Astro build served by nginx.
# PUBLIC_GRADER_URL is baked in at build time (exam pages inline it via import.meta.env).
ARG PUBLIC_GRADER_URL=http://localhost:8000/grade

FROM node:22-alpine AS build
WORKDIR /app
ARG PUBLIC_GRADER_URL
ENV PUBLIC_GRADER_URL=${PUBLIC_GRADER_URL:-http://localhost:8000/grade} \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm astro build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ > /dev/null || exit 1
